rules_version = '2';
// Carreau Competition Desk (beta) — who can read and change what.
//  - Anyone can read competitions and results (spectators need no account).
//  - Every device signs in anonymously; the device that creates a competition owns it.
//  - The owner keeps two private codes. A device that presents the organiser code becomes an
//    organiser (full control); one that presents the scorer code can enter scores and move games.
//  - Site admins (Google sign-in, listed below) can change or delete any competition and switch
//    open testing on or off (config/site). While open testing is on, anyone can run any competition.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function tdoc(tid) { return /databases/$(database)/documents/tournaments/$(tid); }
    function mdoc(tid) { return /databases/$(database)/documents/tournaments/$(tid)/members/$(request.auth.uid); }
    function owns(tid) { return signedIn() && get(tdoc(tid)).data.ownerUid == request.auth.uid; }
    function role(tid) { return signedIn() && exists(mdoc(tid)) ? get(mdoc(tid)).data.role : ''; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true
                           && request.auth.token.email in ['samuelcblakey@gmail.com']; }
    // Open testing (beta): every signed-in visitor can run every competition. On unless config/site says otherwise.
    function cfg() { return /databases/$(database)/documents/config/site; }
    function openTesting() { return !exists(cfg()) || get(cfg()).data.openTesting != false; }
    function canEdit(tid) { return isAdmin() || owns(tid) || role(tid) == 'edit' || (signedIn() && openTesting()); }
    function canScore(tid) { return canEdit(tid) || role(tid) == 'score'; }
    function codes(tid) { return get(/databases/$(database)/documents/tournaments/$(tid)/private/codes).data; }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canEdit(tid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owns(tid) || isAdmin();

      match /private/{docId} {
        allow read: if docId == 'codes' && canEdit(tid);
        allow write: if docId == 'codes' && (owns(tid) || isAdmin());
      }

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || canEdit(tid));
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'code', 'joinedAt'])
          && ((request.resource.data.role == 'edit' && request.resource.data.code == codes(tid).edit)
           || (request.resource.data.role == 'score' && request.resource.data.code == codes(tid).score));
        allow delete: if signedIn() && (request.auth.uid == uid || owns(tid) || isAdmin());
      }

      match /matches/{mid} {
        allow read: if true;
        allow create, update: if canScore(tid);
        allow delete: if canEdit(tid);
      }
    }
  }
}
