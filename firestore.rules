rules_version = '2';
// Carreau Competition Desk (beta) — who can read and change what.
//  - Anyone can read competitions and results (spectators need no account).
//  - Every device signs in anonymously; the device that creates a competition owns it.
//  - The owner keeps two private codes. A device that presents the organiser code becomes an
//    organiser (full control); one that presents the scorer code can enter scores and move games.
//  - Site admins (Google sign-in, listed below) can change or delete any competition and switch
//    open testing on or off (config/site). While open testing is on, anyone can run any competition.
//  - Organisers can archive a finished competition; after that only the admin can see or restore it.
//  - Only the admin can delete a competition; organisers archive instead.
//  - Team score entry (config/site.teamScoring: false, 'admin' = only admin-registered competitions, true = everyone): a team link makes a device a 'team' member; it can only
//    propose a score for its own game, or confirm/dispute the other team's. An organiser's screen publishes results.
//  - Visitors only list their own competitions plus the examples (listed); examples are view-only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function tdoc(tid) { return /databases/$(database)/documents/tournaments/$(tid); }
    function mdoc(tid) { return /databases/$(database)/documents/tournaments/$(tid)/members/$(request.auth.uid); }
    function owns(tid) { return signedIn() && get(tdoc(tid)).data.ownerUid == request.auth.uid; }
    function role(tid) { return signedIn() && exists(mdoc(tid)) ? get(mdoc(tid)).data.role : ''; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true
                           && request.auth.token.email in ['samuelcblakey@gmail.com']; }
    // Open testing (beta): every signed-in visitor can run every competition. On unless config/site says otherwise.
    function cfg() { return /databases/$(database)/documents/config/site; }
    function openTesting() { return !exists(cfg()) || get(cfg()).data.openTesting != false; }
    // examples (listed) are view-only for visitors even in open testing
    function canEdit(tid) { return isAdmin() || owns(tid) || role(tid) == 'edit'
                                   || (signedIn() && openTesting() && get(tdoc(tid)).data.get('listed', false) != true); }
    function canScore(tid) { return canEdit(tid) || role(tid) == 'score'; }
    // archived competitions are hidden from everyone except the admin
    function notArchived(tid) { return get(tdoc(tid)).data.get('archived', false) != true; }
    // team score entry (site switch config/site.teamScoring, and the competition's scoreMode)
    function myTeam(tid) { return signedIn() && exists(mdoc(tid)) && get(mdoc(tid)).data.role == 'team' ? get(mdoc(tid)).data.teamId : ''; }
    // site switch: true = every organiser; 'admin' = only competitions the admin registered in config/site.teamScoringComps
    function teamScoringOn(tid) { return exists(cfg())
                                   && (get(cfg()).data.get('teamScoring', false) == true
                                       || (get(cfg()).data.get('teamScoring', false) == 'admin'
                                           && get(cfg()).data.get('teamScoringComps', {}).get(tid, false) == true))
                                   && get(tdoc(tid)).data.get('scoreMode', 'organiser') in ['teams', 'teams-auto']; }
    // a team may only touch the proposal on its own unfinished game: propose a score, or confirm/dispute the other team's
    function teamUpdate(tid) {
      let me = myTeam(tid);
      let p = request.resource.data.proposal;
      let old = resource.data.get('proposal', null);
      return me != '' && teamScoringOn(tid) && notArchived(tid) && resource.data.get('done', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposal'])
        && (me in resource.data.get('a', []) || me in resource.data.get('b', []))
        && ((p.status == 'pending' && p.by == me && p.keys().hasOnly(['sa', 'sb', 'by', 'at', 'status', 'time']) && p.get('time', false) is bool
             && (old == null || old.by == me || old.status in ['disputed', 'applied', 'auto']))
         || (old != null && old.status == 'pending' && old.by != me && p.sa == old.sa && p.sb == old.sb && p.by == old.by
             && p.status in ['confirmed', 'disputed'] && p.confirmedBy == me));
    }
    function codes(tid) { return get(/databases/$(database)/documents/tournaments/$(tid)/private/codes).data; }

    // config/site is public (open testing switch); config/creators holds the admin's private nicknames for creators
    match /config/{docId} {
      allow read: if docId == 'site' || isAdmin();
      allow write: if isAdmin();
    }

    match /tournaments/{tid} {
      allow get: if resource.data.get('archived', false) != true || isAdmin();
      allow list: if isAdmin() || resource.data.archived == false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ((canEdit(tid) && resource.data.get('archived', false) != true) || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      // organisers can only archive; deleting a competition is admin-only
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read: if (docId == 'codes' || docId == 'teamcodes') && canEdit(tid);
        allow write: if (docId == 'codes' && (owns(tid) || isAdmin())) || (docId == 'teamcodes' && canEdit(tid));
      }

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || canEdit(tid));
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'code', 'joinedAt', 'teamId'])
          && ((request.resource.data.role == 'edit' && request.resource.data.code == codes(tid).edit)
           || (request.resource.data.role == 'score' && request.resource.data.code == codes(tid).score)
           || (request.resource.data.role == 'team' && request.resource.data.code is string && request.resource.data.code.size() > 0
               && request.resource.data.code == get(/databases/$(database)/documents/tournaments/$(tid)/private/teamcodes).data.get(request.resource.data.teamId, '#')));
        allow delete: if signedIn() && (request.auth.uid == uid || owns(tid) || isAdmin());
      }

      match /matches/{mid} {
        allow read: if notArchived(tid) || isAdmin();
        allow create: if (canScore(tid) && notArchived(tid)) || isAdmin();
        allow update: if (canScore(tid) && notArchived(tid)) || isAdmin() || teamUpdate(tid);
        allow delete: if (canEdit(tid) && notArchived(tid)) || isAdmin();
      }
    }
    // SN Pétanque Academy (academy.snpetanque.com): one document per player, keyed by their uid, with their results underneath.
    // A player reads and writes only their own; the admin can read everyone's (the Academy admin page).
    match /academy/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      match /attempts/{aid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
